# Copy to .env (chmod 600). Only used on first start, when no users exist yet.
# Leave empty to have a random admin password printed in `docker compose logs`.
DAPNET_ADMIN_PASSWORD=

# Name shown as the node in the UI and on transmitters
DAPNET_NODE_NAME=lucifernet

# Time zone for the local-time pager broadcast (addresses 208/224)
TZ=Asia/Kuala_Lumpur

# Host ports
DAPNET_HTTP_PUBLISH=8097
DAPNET_TX_PUBLISH=43434

# Set to 1 to log every HTTP request
DAPNET_ACCESS_LOG=0
