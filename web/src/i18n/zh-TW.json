  "home": {
    "carousel": {
      "1": {
        "title": "歡迎使用 DAPNET Web！",
        "text": "DAPNET（去中心化業餘無線電尋呼網路）是由業餘無線電愛好者運營的網路。由於使用業餘無線電頻率，禁止任何商業用途。<br>如果您是持照的業餘無線電操作員，請立即申請登入賬號。",
        "link": "NONE"
      },
      "2": {
        "title": "RasPager 發射機",
        "text": "低成本、低功率的個人發射機，作為樹莓派的擴充套件板使用。",
        "link": "http://hampager.de/dokuwiki/doku.php?id=raspager"
      },
      "3": {
        "title": "覆蓋地圖",
        "text": "發射機及其模擬覆蓋範圍會顯示在地圖上。",
        "link": "NONE"
      },
      "4": {
        "title": "發射機觸控式螢幕",
        "text": "基於 Nextion 顯示屏、簡單易用的圖形控制介面，透過 UART 或 USB 轉 UART 連線到發射機主機。",
        "link": "http://hampager.de/dokuwiki/doku.php?id=unipagernextion"
      },
      "5": {
        "title": "UniPager — 一套軟體支援所有發射機",
        "text": "UniPager 以 Rust 編寫，可控制所有型別的發射機：RasPager、Ericsson C9000、音效卡和 RFM69。提供 Debian 軟體包，便於安裝和更新。",
        "link": "http://hampager.de/dokuwiki/doku.php?id=unipager"
      },
      "6": {
        "title": "Swissphone 現代尋呼機",
        "text": "面向專業使用者的高階型號。",
        "link": "http://hampager.de/dokuwiki/doku.php?id=swissphonedescription"
      },
      "7": {
        "title": "基於 SDR 與 GM1200 的發射機",
        "text": "只需一臺樹莓派、一臺支援 9600 波特的電臺和一個簡單的音訊介面，也可以與觸控式螢幕搭配使用。",
        "link": "http://hampager.de/dokuwiki/doku.php?id=9k6"
      },
      "8": {
        "title": "AlphaPOC 602R 尋呼機",
        "text": "市面有售，體積小，無需改裝，可直接在尋呼機上程式設計。",
        "link": "http://hampager.de/dokuwiki/doku.php?id=alphapocdescription"
      },
      "9": {
        "title": "DAPNET 的架構",
        "text": "採用 REST、WebSocket 等透明且現代的通訊協議。",
        "link": "NONE"
      },
      "10": {
        "title": "工單系統支援",
        "text": "支援請求由團隊處理，響應迅速並能最大程度共享知識。",
        "link": "https://support.hampager.de/"
      }
    },
